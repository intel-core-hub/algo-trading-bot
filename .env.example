# Binance Testnet APIキー(実資金のキーは絶対に入れないこと)
#
# このファイルをコピーして .env を作り、値だけを埋める:
#   cp .env.example .env
#
# .env はコミットしない(.gitignoreで除外済み)。
# キーの発行はユーザー自身が行う(Claude Codeは値の入力・生成を行わない)。

# Spot Testnet: https://testnet.binance.vision で発行
BINANCE_TESTNET_SPOT_API_KEY=
BINANCE_TESTNET_SPOT_API_SECRET=

# Futures Testnet: https://testnet.binancefuture.com で発行(Spotとは別アカウント・別キー)
BINANCE_TESTNET_FUTURES_API_KEY=
BINANCE_TESTNET_FUTURES_API_SECRET=
